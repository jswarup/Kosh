{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fenst",
  "version": "0.1.0",
  "identifier": "com.kosh.fenst",
  "build": {
    "frontendDist": "./src/frieze/frontend",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fenst",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "focus": true,
        "visible": true,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "src/frieze/icons/32x32.png",
      "src/frieze/icons/128x128.png",
      "src/frieze/icons/icon.ico",
      "src/frieze/icons/icon.png"
    ]
  }
}
