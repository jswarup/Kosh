{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frieze",
  "version": "0.1.0",
  "identifier": "com.kosh.frieze",
  "build": {
    "frontendDist": "./frontend",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Frieze",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "focus": true,
        "visible": true,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
