  <!-- ===================================================================================================================== -->
  <!-- RUBE: Logic Registers, Ports, and Descriptors                                                                         -->
  <!-- ===================================================================================================================== -->

  <Type Name="kosh::rube::reg::Reg">
    <DisplayString Condition="_X != 0">Reg(Val: 0x{_Val,X}, X: 0x{_X,X})</DisplayString>
    <DisplayString Condition="_X == 0">Reg(0x{_Val,X})</DisplayString>
    <Expand>
      <Item Name="[value]">_Val,X</Item>
      <Item Name="[unknown_mask]">_X,X</Item>
      <Item Name="[is_valid]">_X == 0</Item>
      <Item Name="[as_bool]" Condition="_X == 0">(_Val &amp; 1) != 0</Item>
    </Expand>
  </Type>
  <Type Name="Reg">
    <DisplayString Condition="_X != 0">Reg(Val: 0x{_Val,X}, X: 0x{_X,X})</DisplayString>
    <DisplayString Condition="_X == 0">Reg(0x{_Val,X})</DisplayString>
    <Expand>
      <Item Name="[value]">_Val,X</Item>
      <Item Name="[unknown_mask]">_X,X</Item>
      <Item Name="[is_valid]">_X == 0</Item>
      <Item Name="[as_bool]" Condition="_X == 0">(_Val &amp; 1) != 0</Item>
    </Expand>
  </Type>

  <Type Name="kosh::rube::port::PortId">
    <DisplayString Condition="(__0.__0 &amp; 0x80000000) != 0" Optional="true">PortId(Out, {__0.__0 &amp; 0x7FFFFFFF})</DisplayString>
    <DisplayString Condition="(0.0 &amp; 0x80000000) != 0" Optional="true">PortId(Out, {0.0 &amp; 0x7FFFFFFF})</DisplayString>
    <DisplayString Optional="true">PortId(In, {__0.__0 &amp; 0x7FFFFFFF})</DisplayString>
    <DisplayString Optional="true">PortId(In, {0.0 &amp; 0x7FFFFFFF})</DisplayString>
    <Expand>
      <Item Name="[direction]" Condition="(__0.__0 &amp; 0x80000000) != 0" Optional="true">"Out"</Item>
      <Item Name="[direction]" Condition="(0.0 &amp; 0x80000000) != 0" Optional="true">"Out"</Item>
      <Item Name="[direction]" Optional="true">"In"</Item>
      <Item Name="[index]" Optional="true">__0.__0 &amp; 0x7FFFFFFF</Item>
      <Item Name="[index]" Optional="true">0.0 &amp; 0x7FFFFFFF</Item>
    </Expand>
  </Type>
  <Type Name="PortId">
    <DisplayString Condition="(__0.__0 &amp; 0x80000000) != 0" Optional="true">PortId(Out, {__0.__0 &amp; 0x7FFFFFFF})</DisplayString>
    <DisplayString Condition="(0.0 &amp; 0x80000000) != 0" Optional="true">PortId(Out, {0.0 &amp; 0x7FFFFFFF})</DisplayString>
    <DisplayString Optional="true">PortId(In, {__0.__0 &amp; 0x7FFFFFFF})</DisplayString>
    <DisplayString Optional="true">PortId(In, {0.0 &amp; 0x7FFFFFFF})</DisplayString>
    <Expand>
      <Item Name="[direction]" Condition="(__0.__0 &amp; 0x80000000) != 0" Optional="true">"Out"</Item>
      <Item Name="[direction]" Condition="(0.0 &amp; 0x80000000) != 0" Optional="true">"Out"</Item>
      <Item Name="[direction]" Optional="true">"In"</Item>
      <Item Name="[index]" Optional="true">__0.__0 &amp; 0x7FFFFFFF</Item>
      <Item Name="[index]" Optional="true">0.0 &amp; 0x7FFFFFFF</Item>
    </Expand>
  </Type>

  <Type Name="kosh::rube::port::PortDesc">
    <DisplayString>{_Name} ({_Type})</DisplayString>
    <Expand>
      <Item Name="name">_Name</Item>
      <Item Name="type">_Type</Item>
      <Item Name="sensitivity">_Sensitivity</Item>
    </Expand>
